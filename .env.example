# Stock Dashboard - Environment Variables
# Copy to .env and fill in your values

# Auth - single allowed user (no registration)
ALLOWED_USERNAME=lalitmittal1991@gmail.com
ALLOWED_PASSWORD=lalit123

# Required for production - use: openssl rand -hex 32
SECRET_KEY=388a3c1a33d8bc8a224a05d379fbe54d16e2771b4ad1e7645b6ed032669ca15c

# Google Sheets API - Service Account JSON path or base64-encoded JSON
# Create service account at: https://console.cloud.google.com/iam-admin/serviceaccounts
# Enable Google Sheets API, download JSON key
GOOGLE_SHEETS_CREDENTIALS_PATH=credentials.json
# Or for Cloud Run, base64-encode the JSON: base64 -i credentials.json
# GOOGLE_SHEETS_CREDENTIALS_JSON=<base64-string>

# GNews API - Free at https://gnews.io/
